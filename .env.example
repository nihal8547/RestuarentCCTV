# --- video ---
# sim = built-in simulated restaurant (no camera/model needed)
# /path/to/video.mp4 = looped file, or rtsp://user:pass@192.168.1.64:554/Streaming/Channels/102
VIDEO_SOURCE=sim
FPS=15
# --- alerts ---
# Alert thresholds (seconds). Defaults are the real ones: 300 = 5 min no waiter, 120 = 2 min uncleaned.
# WAIT_ALERT_SEC=300
# CLEAN_ALERT_SEC=120
# WAIT_ALERT_SEC=300
# CLEAN_ALERT_SEC=120
# --- detection (real camera only) ---
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.25
# YOLO_DEVICE: empty = auto, cpu, or 0 (first GPU)
YOLO_DEVICE=
# STAFF_INFER=1                       # roaming+vote staff inference
# TABLE_DIFF_THR=0.45                 # dirty-table appearance threshold (see Table drawer score)
# ITEM_MIN=2                          # cups/plates on an empty table = dirty
# INSTALL_YOLO=1 TORCH_INDEX=https://download.pytorch.org/whl/cu121   # docker build args for GPU
ANCHOR=center            # center for overhead cameras, foot for angled cameras
# STAFF_HSV_LOW=5,120,150  # waiter uniform colour range (OpenCV HSV)
# STAFF_HSV_HIGH=25,255,255
# --- misc ---
RESTAURANT_TZ=Asia/Qatar

# --- staff notifications (optional) ---
RESTAURANT_NAME=My Restaurant
# n8n / Zapier / Make webhook -> forward to WhatsApp, SMS, Slack...
# ALERT_WEBHOOK_URL=https://your-n8n.example.com/webhook/restaurant-alerts
# Direct Telegram (create a bot with @BotFather, add it to the staff group)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- login & roles (staff < manager < owner) ---
# Setting ADMIN_PASSWORD enables login and creates the first owner. More users: Settings > Users.
# ADMIN_USER=owner
# ADMIN_PASSWORD=change-me-now
# AUTH_SECRET=long-random-string      # keeps sessions valid across restarts
# --- cameras (multi-camera). Table zones choose their camera in Settings > Table zones ---
# CAMERAS={"cam1":"rtsp://user:pass@192.168.1.64:554/Streaming/Channels/102","cam2":"rtsp://user:pass@192.168.1.65/stream2"}
# CAMERA_OFFLINE_SEC=10               # no frames for this long -> "camera offline" alert
# USE_BYTETRACK=0                     # 1 = ultralytics ByteTrack IDs (YOLO mode)
# --- weekly report (PDF) sent via the webhook/Telegram above ---
# WEEKLY_REPORT=1  REPORT_WEEKDAY=0  REPORT_HOUR=9     # Monday 09:00 restaurant time
# --- multi-restaurant hub ---
# HUB_ENABLED=1                       # on the central server
# HUB_URL=https://hub.example.com     # on each restaurant PC
# HUB_KEY=vk_...                      # created in All Venues > Add venue
